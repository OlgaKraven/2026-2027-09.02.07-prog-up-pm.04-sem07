<Window x:Class="Shop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Shop" Title="Магазин — каталог" Width="1120" Height="760" WindowStartupLocation="CenterScreen" Background="#F4F7FA">
 <Window.Resources><local:LowStockConverter x:Key="LowStock"/></Window.Resources>
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top">
   <Grid><TextBlock x:Name="SubjectText" FontSize="23" FontWeight="Bold"/><TextBlock x:Name="UserText" HorizontalAlignment="Right" FontSize="16" /></Grid>
   <WrapPanel Margin="0,12,0,12">
    <TextBlock Text="Логин:" VerticalAlignment="Center"/><TextBox x:Name="LoginBox" AutomationProperties.AutomationId="LoginBox" Width="140" Margin="8,0"/>
    <Button Content="Войти" AutomationProperties.AutomationId="LoginButton" Click="Login_Click" Padding="12,5"/>
    <Button Content="Выйти" AutomationProperties.AutomationId="LogoutButton" Click="Logout_Click" Margin="8,0" Padding="12,5"/>
    <Button Content="Отменить заказ" AutomationProperties.AutomationId="CancelButton" Click="Cancel_Click" Padding="12,5"/>
   </WrapPanel>
  </StackPanel>
  <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" FontSize="14" Margin="0,10"/>
  <Grid>
   <Grid x:Name="CatalogPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,10">
     <TextBlock Text="Поиск:" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" AutomationProperties.AutomationId="SearchBox" Width="230" Margin="8,0" TextChanged="Search_Changed"/>
     <ComboBox x:Name="CategoryBox" AutomationProperties.AutomationId="CategoryBox" Width="210" SelectionChanged="Options_Changed"/>
     <ComboBox x:Name="SortBox" AutomationProperties.AutomationId="SortBox" Width="230" Margin="8,0" SelectionChanged="Options_Changed"><ComboBoxItem Content="Цена по возрастанию"/><ComboBoxItem Content="Цена по убыванию"/></ComboBox>
    </WrapPanel>
    <DataGrid x:Name="ProductsGrid" AutomationProperties.AutomationId="ProductsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" MouseDoubleClick="Product_Open">
     <DataGrid.RowStyle><Style TargetType="DataGridRow"><Style.Triggers><DataTrigger Binding="{Binding Available, Converter={StaticResource LowStock}}" Value="True"><Setter Property="Background" Value="#FFD6D6"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="2*"/>
      <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="*"/>
      <DataGridTextColumn Header="Цена со скидкой" Binding="{Binding DiscountPrice, StringFormat=F2}" Width="*"/>
      <DataGridTextColumn Header="Остаток" Binding="{Binding Available}" Width="80"/>
      <DataGridTemplateColumn Header="Действие" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Открыть товар" Click="Product_Button" Tag="{Binding}" Padding="5"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
   <Grid x:Name="DetailPanel" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
     <Button Content="Назад к каталогу" AutomationProperties.AutomationId="BackButton" Click="Back_Click" HorizontalAlignment="Left" Padding="12,6"/>
     <WrapPanel Margin="0,12"><Image x:Name="ProductImage" Width="90" Height="90"/><TextBlock x:Name="DetailsText" FontSize="16" TextWrapping="Wrap" Width="850" Margin="12,0"/></WrapPanel>
    </StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,10">
     <TextBlock Text="Размер:" VerticalAlignment="Center"/><ComboBox x:Name="SizeBox" AutomationProperties.AutomationId="SizeBox" Width="130" Margin="8,0"/>
     <TextBlock Text="Количество:" VerticalAlignment="Center"/><TextBox x:Name="QuantityBox" AutomationProperties.AutomationId="QuantityBox" Width="80" Text="1" Margin="8,0"/>
     <Button Content="Добавить в заказ" AutomationProperties.AutomationId="AddButton" Click="Add_Click" Padding="12,6"/>
    </WrapPanel>
    <DataGrid x:Name="CartGrid" AutomationProperties.AutomationId="CartGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns>
     <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="*"/><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="*"/><DataGridTextColumn Header="Сумма" Binding="{Binding Total}" Width="*"/>
    </DataGrid.Columns></DataGrid>
    <Button Grid.Row="3" Content="Подтвердить заказ" AutomationProperties.AutomationId="ConfirmButton" Click="Confirm_Click" HorizontalAlignment="Right" Padding="16,8" Margin="0,10"/>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
